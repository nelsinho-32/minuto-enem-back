generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  STUDENT
  TEACHER
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String            @unique
  password           String
  role               Role              @default(STUDENT)
  xp                 Int               @default(0)
  currentStreak      Int               @default(0)
  longestStreak      Int               @default(0)
  iceFreezes         Int               @default(0)
  lastStudyDate      DateTime?
  createdClassrooms  Classroom[]       @relation("TeacherClassrooms")
  enrolledClassrooms Classroom[]       @relation("StudentClassrooms")
  questionAttempts   QuestionAttempt[]
  flashcardReviews   FlashcardReview[]
  notes              Note[]
  trailProgresses    TrailProgress[]
  createdAt          DateTime          @default(now())
}

model Classroom {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  teacherId String
  teacher   User     @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  students  User[]   @relation("StudentClassrooms")
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Class {
  id        String @id @default(uuid())
  code      String @unique
  name      String
  teacherId String
}

model Task {
  id          String     @id @default(uuid())
  title       String     @default("")
  description String?    @db.Text
  topic       String
  total       Int        @default(0)
  questionIds String[]   @default([])
  dueDate     DateTime?
  status      String     @default("PENDING_APPROVAL") // "PENDING_APPROVAL" | "APPROVED" | "COMPLETED"
  classId     String
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  tags      String[] @default([])
  lessonId  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trail {
  id          String          @id @default(uuid())
  title       String
  description String?         @db.Text
  area        String
  subjectId   String?
  subject     Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessonIds   String[]        @default([])
  questionIds String[]        @default([])
  totalSteps  Int             @default(1)
  progresses  TrailProgress[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TrailProgress {
  id                 String   @id @default(uuid())
  userId             String
  trailId            String
  completedSteps     Int      @default(0)
  completedLessonIds String[] @default([])
  progressPercent    Float    @default(0)
  status             String   @default("IN_PROGRESS") // "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED"
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trail              Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, trailId])
}

model Question {
  id               String                      @id @default(uuid())
  year             Int
  area             String
  subject          String
  difficulty       String?
  text             String                      @db.Text
  options          Json
  correctAnswer    Int
  explanation      String?                     @db.Text
  errorRate        Float?
  embedding        Unsupported("vector(768)")?
  attempts         QuestionAttempt[]
  flashcardReviews FlashcardReview[]
}

model QuestionAttempt {
  id             String   @id @default(uuid())
  userId         String
  questionId     String
  selectedAnswer Int
  isCorrect      Boolean
  createdAt      DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  icon      String   @default("book")
  lessons   Lesson[]
  trails    Trail[]
  createdAt DateTime @default(now())
}

model Lesson {
  id         String   @id @default(uuid())
  title      String
  content    String
  videos     String[] @default([]) // Array nativo para os vídeos
  references String[] @default([]) // Array nativo para os livros
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model FlashcardReview {
  id             String    @id @default(uuid())
  userId         String
  questionId     String
  repetition     Int       @default(0)
  interval       Int       @default(0)
  easeFactor     Float     @default(2.5)
  nextReviewDate DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewDate])
}
